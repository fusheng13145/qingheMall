{
  "name": "qinghe-mall-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --ext .js,.vue",
    "format": "prettier --write \"src/**/*.{js,vue,json}\"",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "vite": "^6.3.5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17",
    "form-data": "^4.0.6"
  }
}
