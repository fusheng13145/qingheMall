{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "type": "stat",
      "title": "后端存活",
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up{job=\"qinghe-mall-backend\"}", "legendFormat": "backend", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "type": "timeseries",
      "title": "请求 QPS",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "QPS", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "type": "timeseries",
      "title": "HTTP 5xx 错误率",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "percent" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx 错误率",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "type": "timeseries",
      "title": "HTTP P95 延迟",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "type": "timeseries",
      "title": "JVM 堆内存使用率",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "unit": "percent", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "heap",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "type": "alertlist",
      "title": "活跃告警",
      "datasource": "${DS_PROMETHEUS}",
      "options": {
        "showOptions": "All alerts",
        "stateFilter": ["alerting", "pending", "no_data"],
        "sortOrder": 2,
        "dashboardTags": []
      },
      "targets": []
    }
  ],
  "schemaVersion": 39,
  "tags": ["qinghe-mall", "backend"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "数据源",
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Shanghai",
  "title": "青禾商城后端监控总览",
  "uid": "qinghe-mall-overview",
  "version": 1
}
