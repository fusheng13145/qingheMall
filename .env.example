# ============================================================
# 青禾商城 部署环境变量模板（.env.example）
# 用法：复制为 .env 后填入真实值，docker compose 自动读取。
# 注意：.env 含敏感信息，禁止提交入仓（已在 .gitignore 忽略）。
# 模板中各默认值仅用于本地开发，生产环境务必替换为强口令/真实凭证。
# ============================================================

# ---------- 数据库（MySQL） ----------
# ⚠️ 生产必须改为强口令，禁止使用下方开发默认
MYSQL_ROOT_PASSWORD=QhMallDev2026!
DB_USERNAME=root
DB_PASSWORD=QhMallDev2026!

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 若 Redis 启用密码，请填写；本地开发可留空
REDIS_PASSWORD=

# ---------- 后端通用 ----------
# 上传目录（容器内固定为 /app/upload，挂载卷持久化）
UPLOAD_DIR=/app/upload

# ---------- 应用安全 ----------
# 生产关闭 Druid 监控台（默认 false）；如需开启必须设强口令
DRUID_MONITOR_ENABLED=false
DRUID_LOGIN_USERNAME=druid
DRUID_LOGIN_PASSWORD=change_me_strong

# CSRF 来源白名单（逗号分隔，生产填真实域名）
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 如需临时放行模拟支付（仅联调用），显式置 true；生产必须保持 false
PAY_MOCK_ENABLED=false

# ---------- 支付宝支付（沙箱/正式，留空则回退模拟） ----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipayNotify
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# ---------- 微信支付 v3（需营业执照，留空则回退模拟） ----------
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/wechatNotify
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# ---------- 监控（P1-19，docker compose 启动 Grafana 必需） ----------
# ⚠️ Grafana 管理员口令为必填（compose 用 :? 强制校验，缺省直接拒绝启动），生产设为强口令
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong
