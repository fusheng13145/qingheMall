<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinghe.mall.order.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.qinghe.mall.order.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_name" property="goodsName"/>
        <result column="goods_image" property="goodsImage"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO oms_order_item (order_id, goods_id, goods_name, goods_image, price, quantity, create_time)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.goodsId}, #{item.goodsName}, #{item.goodsImage},
             #{item.price}, #{item.quantity}, #{item.createTime})
        </foreach>
    </insert>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM oms_order_item WHERE order_id = #{orderId}
    </select>

    <delete id="deleteByOrderId">
        DELETE FROM oms_order_item WHERE order_id = #{orderId}
    </delete>

</mapper>
