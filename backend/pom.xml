<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 架构级遗留项（2026-08-09）：2.7.18(EOL) → 3.3.13 + JDK 17 + jakarta 命名空间 -->
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.qinghe</groupId>
    <artifactId>qinghe-mall</artifactId>
    <version>1.0.0</version>
    <name>qinghe-mall</name>
    <description>青禾商城后端服务</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <druid.version>1.2.23</druid.version>
        <pagehelper.version>2.1.0</pagehelper.version>
        <redisson.version>3.27.2</redisson.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <fastjson.version>2.0.53</fastjson.version>
        <!-- JaCoCo 行覆盖率门禁下限（小数，0.60=60%）。CI `mvn test` 阶段校验，
             低于该值构建失败。基线沿革：0.38（2026-08-08 全量 101 用例实测
             1216/3153≈38.6%）→ 0.60（2026-08-10 全量 323 用例实测 2454/3435≈71.4%，
             上调留 ~11pp 余量防回归）；目标 ≥0.85，随测试补全逐步上调。 -->
        <jacoco.line.min>0.60</jacoco.line.min>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- Druid -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- PageHelper -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>${pagehelper.version}</version>
        </dependency>

        <!-- Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- AOP：@RateLimit 限流切面（P2-3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Actuator + Micrometer Prometheus：监控指标（P2-2，/actuator/prometheus） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Spring Session Redis：多实例 Session 共享（P3） -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- MySQL（P1-16：8.0.33 存在 CVE-2023-22102，升级 8.4 LTS，坐标改为 com.mysql:mysql-connector-j） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Commons Codec（版本由 spring-boot-dependencies 管理，Boot 3.3 → 1.16.1） -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>

        <!-- Spring Security Crypto：BCrypt 密码哈希（版本由 spring-boot-dependencies 管理） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Commons Lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <!-- Fastjson2（架构级遗留项：1.2.83 → 2.0.x，包名 com.alibaba.fastjson2，核心 API 兼容） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <!-- ZXing：微信 Native 支付二维码生成 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.2</version>
        </dependency>

        <!-- BouncyCastle：兼容 PKCS1/PKCS8 格式的支付宝/微信密钥解析
             P2：1.70(jdk15on, 2021) → 1.78(jdk18on)，修复 CVE-2023-33202 等侧信道漏洞 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78</version>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 2026-08-09：Boot 3.3.13 迁移完成，移除 P0-5 的 spring-framework-bom 5.3.39 手动覆盖
         （Boot 3 自带 Spring Framework 6.1.x 版本管理，无需也不应再覆盖） -->
    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JaCoCo 覆盖率：生成报告 + 行覆盖率门禁（RR-4 升级）。
                 注意：项目路径含中文，JDK 21 下 JaCoCo agent 无法向中文路径写 jacoco.exec，
                 故将数据文件重定向到 ASCII 的 ${java.io.tmpdir}，跨机可移植。
                 门禁：check 绑定 test 阶段，CI `mvn test` 阶段校验；低于 jacoco.line.min 则构建失败。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <destFile>${java.io.tmpdir}/qinghe-mall/jacoco.exec</destFile>
                    <dataFile>${java.io.tmpdir}/qinghe-mall/jacoco.exec</dataFile>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- P1-17：依赖漏洞扫描（OWASP Dependency-Check）。
         默认不启用：NVD 数据下载慢且受官方限流，CI 单独 job 执行 mvn -Psecurity-check verify。
         检测结果见 target/dependency-check-report.html -->
    <profiles>
        <profile>
            <id>security-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>8.4.3</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
