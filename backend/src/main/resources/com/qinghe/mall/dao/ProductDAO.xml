<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinghe.mall.dao.ProductDAO">

    <resultMap id="BaseResultMap" type="com.qinghe.mall.dataobject.ProductDO">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="price" property="price" jdbcType="DOUBLE"/>
        <result column="purchase_num" property="purchaseNum" jdbcType="INTEGER"/>
        <result column="product_intro" property="productIntro" jdbcType="VARCHAR"/>
        <result column="product_imgs" property="productImgs" jdbcType="VARCHAR"/>
        <result column="gmt_created" property="gmtCreated" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, price, purchase_num, product_intro, product_imgs, gmt_created, gmt_modified
    </sql>

    <select id="queryAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        ORDER BY gmt_created DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.qinghe.mall.dataobject.ProductDO">
        INSERT INTO product (id, name, price, purchase_num, product_intro, product_imgs, gmt_created, gmt_modified)
        VALUES (#{id}, #{name}, #{price}, #{purchaseNum}, #{productIntro}, #{productImgs}, #{gmtCreated}, #{gmtModified})
    </insert>

    <update id="update" parameterType="com.qinghe.mall.dataobject.ProductDO">
        UPDATE product
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="price != null">price = #{price},</if>
            <if test="purchaseNum != null">purchase_num = #{purchaseNum},</if>
            <if test="productIntro != null">product_intro = #{productIntro},</if>
            <if test="productImgs != null">product_imgs = #{productImgs},</if>
            gmt_modified = #{gmtModified}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product WHERE id = #{id}
    </delete>

</mapper>
