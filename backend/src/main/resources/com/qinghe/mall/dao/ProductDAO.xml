<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qinghe.mall.dao.ProductDAO">

    <resultMap id="BaseResultMap" type="com.qinghe.mall.dataobject.ProductDO">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="brand" property="brand" jdbcType="VARCHAR"/>
        <result column="merchant_id" property="merchantId" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="price" property="price" jdbcType="DECIMAL"/>
        <result column="purchase_num" property="purchaseNum" jdbcType="INTEGER"/>
        <result column="product_intro" property="productIntro" jdbcType="VARCHAR"/>
        <result column="product_imgs" property="productImgs" jdbcType="VARCHAR"/>
        <result column="gmt_created" property="gmtCreated" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, brand, merchant_id, status, price, purchase_num, product_intro, product_imgs, gmt_created, gmt_modified
    </sql>

    <!-- 动态条件：名称/介绍全文搜索（P1-20 FULLTEXT 优先，单字降级 LIKE）/ 品牌筛选 / 排序 -->
    <sql id="Search_Condition">
        <where>
            <if test="keyword != null and keyword != ''">
                <choose>
                    <!-- ≥2 字走 ngram FULLTEXT（NATURAL LANGUAGE 模式，无操作符注入风险），消除全表扫描 -->
                    <when test="keyword.length() >= 2">
                        AND MATCH(name, product_intro) AGAINST(#{keyword} IN NATURAL LANGUAGE MODE)
                    </when>
                    <!-- 单字 ngram 无法分词匹配，降级 LIKE（低频，代价可接受） -->
                    <otherwise>
                        AND name LIKE CONCAT('%', #{keyword}, '%')
                    </otherwise>
                </choose>
            </if>
            <if test="brand != null and brand != ''">
                AND brand = #{brand}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="queryAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        <include refid="Search_Condition"/>
        <choose>
            <when test="sort == 'sales_desc'">ORDER BY purchase_num DESC, gmt_created DESC</when>
            <when test="sort == 'price_asc'">ORDER BY price ASC, gmt_created DESC</when>
            <when test="sort == 'price_desc'">ORDER BY price DESC, gmt_created DESC</when>
            <otherwise>ORDER BY gmt_created DESC</otherwise>
        </choose>
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE id = #{id}
    </select>

    <select id="findByIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 去重品牌列表（供筛选下拉） -->
    <select id="listBrands" resultType="string">
        SELECT DISTINCT brand FROM product WHERE brand IS NOT NULL AND brand != '' ORDER BY brand
    </select>

    <!-- 商家店铺商品（M6：归属过滤 + 关键词 + 状态；P1-20 全文搜索） -->
    <select id="queryByMerchantId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE merchant_id = #{merchantId}
        <if test="keyword != null and keyword != ''">
            <choose>
                <when test="keyword.length() >= 2">
                    AND MATCH(name, product_intro) AGAINST(#{keyword} IN NATURAL LANGUAGE MODE)
                </when>
                <otherwise>
                    AND name LIKE CONCAT('%', #{keyword}, '%')
                </otherwise>
            </choose>
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY gmt_created DESC
    </select>

    <insert id="insert" parameterType="com.qinghe.mall.dataobject.ProductDO">
        INSERT INTO product (id, name, brand, merchant_id, status, price, purchase_num, product_intro, product_imgs, gmt_created, gmt_modified)
        VALUES (#{id}, #{name}, #{brand}, #{merchantId}, #{status}, #{price}, #{purchaseNum}, #{productIntro}, #{productImgs}, #{gmtCreated}, #{gmtModified})
    </insert>

    <update id="update" parameterType="com.qinghe.mall.dataobject.ProductDO">
        UPDATE product
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="brand != null">brand = #{brand},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="price != null">price = #{price},</if>
            <if test="purchaseNum != null">purchase_num = #{purchaseNum},</if>
            <if test="productIntro != null">product_intro = #{productIntro},</if>
            <if test="productImgs != null">product_imgs = #{productImgs},</if>
            gmt_modified = #{gmtModified}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product WHERE id = #{id}
    </delete>

    <update id="increasePurchaseNum">
        UPDATE product
        SET purchase_num = purchase_num + #{num}, gmt_modified = NOW()
        WHERE id = #{id}
    </update>

    <!-- 店铺主页：本店在售商品销量合计（A3） -->
    <select id="sumSalesByMerchant" resultType="long">
        SELECT COALESCE(SUM(purchase_num), 0) FROM product
        WHERE merchant_id = #{merchantId} AND status = 'ON'
    </select>

</mapper>
